CONFIG tmc5262_stealthchop.cfg
DICTIONARY atmega2560.dict

G28
DUMP_TMC STEPPER=stepper_x REGISTER=PWMCONF
DUMP_TMC STEPPER=stepper_x REGISTER=COIL_INDUCT
DUMP_TMC STEPPER=stepper_x REGISTER=CURRENT_PI_REG
DUMP_TMC STEPPER=stepper_x REGISTER=ANGLE_PI_REG
DUMP_TMC STEPPER=stepper_x REGISTER=SGP_BEMF
INIT_TMC STEPPER=stepper_x
SET_TMC_FIELD STEPPER=stepper_x FIELD=tpwmthrs VELOCITY=100
G1 X100 F12000
SET_TMC_CURRENT STEPPER=stepper_x CURRENT=1.0
M18
G28
